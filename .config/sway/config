input 7247:99:HS-HW186A-3B-US-01-21-_USB_Keyboard {
  #xkb_layout "eu"
  #####exchange Ctrl and Caps
  xkb_options ctrl:swapcaps
}
input 1:1:AT_keyboard {
  #xkb_layout "eu"
  #####exchange Ctrl and Caps
  xkb_options ctrl:swapcaps
}
input 9390:8211:RAPOO_Rapoo_2.4G_Wireless_Device_Mouse {
  left_handed enable
  natural_scroll enable
}
input 1267:12600:MSFT0001:00_04F3:3138_TouchPad {
  natural_scroll enable
}
