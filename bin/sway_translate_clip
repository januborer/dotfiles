#!/bin/sh

# 检查依赖工具是否安装
if ! command -v wl-paste > /dev/null || ! command -v trans > /dev/null || ! command -v notify-send > /dev/null; then
    notify-send -u critical -t 5000 "翻译错误" "缺少依赖工具：wl-paste, translate-shell (trans) 或 notify-send。"
    exit 1
fi

# 从 Wayland 剪贴板获取内容 (使用 -p 参数读取主选择区 Primary Selection)
# 对于大多数“选中即复制”的操作，读取 Primary Selection (主选择区) 更加即时。
# 您也可以尝试 -c 来读取 Clipboard Selection (剪贴板)，默认就是-c
# INPUT_TEXT=$(wl-paste -n -p)
# INPUT_TEXT=$(wl-paste -n)
INPUT_TEXT=$(wl-paste | sed -e 's/^[ \t\n]*//g' -e 's/[ \t\n]*$//g' -e 's/\n/ /g')

if [ -z "$INPUT_TEXT" ]; then
    notify-send -i info -t 5000 "翻译提示" "未检测到文本内容。"
    exit 0
fi

# 限制输入文本长度，避免通知内容过长 (例如只取前10个字符用于通知标题)
# PREVIEW=$(echo "$INPUT_TEXT" | head -c 10)
#
#判断是否为中文
# if echo "$INPUT_TEXT" | grep -q '[\xe4-\xe9]' ; then
if echo "$INPUT_TEXT" | pcre2grep -q  '\p{Han}'; then
    # 中文 → 英文
    TRANSLATION="$(trans -b :en "$INPUT_TEXT" 2>/dev/null)"
    TRANS_STATUS=$?
else
    # *→ 中文
    TRANSLATION="$(trans -b :zh "$INPUT_TEXT" 2>/dev/null)"
    TRANS_STATUS=$?
fi
# 如果上面trans翻译成功，那么将翻译结果赋值给wl-copy
if [ "$TRANS_STATUS" -eq 0 ] ; then
  echo "$TRANSLATION" | wl-copy
fi
# 使用 notify-send 显示结果
# -i info: 使用信息图标
# -t 20000: 停留 20000 毫秒 (20秒)
# notify-send -i info -t 20000 "原文: $PREVIEW..." "$TRANSLATION"
notify-send -i info "Origin: $INPUT_TEXT" ">>>: $TRANSLATION"
