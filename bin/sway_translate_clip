#!/bin/sh

# 基于fuzzel和trans的翻译脚本：如果输入y那么就翻译wl-paste的内容，否则翻译输入内容

if ! command -v wl-paste > /dev/null || ! command -v trans > /dev/null || ! command -v notify-send > /dev/null; then
    notify-send -u critical -t 5000 "翻译错误" "缺少依赖工具：wl-paste, translate-shell (trans) 或 notify-send。"
    exit 1
fi

INPUT_TOOL="fuzzel"
INPUT_TEXT=$(echo "" | "$INPUT_TOOL" --dmenu --lines=0 --width=40 --background=282a36ff --text=f8f8f2ff --border-width=2 --border-color=bd93f9ff --selection-text=8be9fdff)
STATUS_INPUT=$?
if [ "$STATUS_INPUT" -ne 0 ] || [ -z "$INPUT_TEXT" ]; then
  notify-send -u critical -t 5000 "cancle"
  exit 0
fi

if [ "$INPUT_TEXT" = "y" ]; then
  NOTIFY_TOOL="notify-send -i info -t 50000"
  INPUT_TEXT=$(wl-paste | sed -e 's/^[ \t\n]*//g' -e 's/[ \t\n]*$//g' -e 's/\n/ /g')
else
  NOTIFY_TOOL="notify-send -i info -t 5000"
fi

if [ -z "$INPUT_TEXT" ]; then
    notify-send -i info -t 5000 "翻译提示" "未检测到文本内容。"
    exit 0
fi

GOOGLE_ENGINE_TOOL="trans -e google -brief"
BING_ENGINE_TOOL="trans -e bing -brief"
YANDEX_ENGINE_TOOL="trans -e yandex -brief"
if echo "$INPUT_TEXT" | pcre2grep -q  '\p{Han}'; then
    TRANSLATION="$($GOOGLE_ENGINE_TOOL :en "$INPUT_TEXT" 2>/dev/null || \
      $BING_ENGINE_TOOL :en "$INPUT_TEXT" 2>/dev/null || \
      $YANDEX_ENGINE_TOOL :en "$INPUT_TEXT" 2>/dev/null)"
    TRANS_STATUS=$?
else
    TRANSLATION="$($GOOGLE_ENGINE_TOOL :zh "$INPUT_TEXT" 2>/dev/null || \
      $BING_ENGINE_TOOL :zh "$INPUT_TEXT" 2>/dev/null || \
      $YANDEX_ENGINE_TOOL :zh "$INPUT_TEXT" 2>/dev/null)"
    TRANS_STATUS=$?
fi

if [ "$TRANS_STATUS" -eq 0 ] && [ "$1" != "word" ]; then
  echo "$TRANSLATION" | wl-copy
fi

$NOTIFY_TOOL "Origin: $INPUT_TEXT" ">>>: $TRANSLATION"
